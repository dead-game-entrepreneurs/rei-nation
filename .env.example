# IPv4 address the console or emulator uses to reach this Docker host.
REI_NATION_PUBLIC_IP=192.0.2.10

# Choose a unique password for this stack before starting it.
POSTGRES_PASSWORD=

# Comma-separated titles: nascar04, gera, tsfp.
REI_NATION_GAMES=nascar04,tsfp
# REI_NATION_BIND=0.0.0.0
# REI_NATION_HEALTH_PORT=8086
# REI_NATION_PG_PORT=55434
# REI_NATION_RELAY=auto
# Optional GoldenEye relay. Relay nodes sign in on TCP 18043; see
# docs/games/gera/internet-play.md. With Compose, keep RELAY_DIR=/gera-relay and
# set RELAY_HOST_DIR to the directory `rei-relay setup` wrote. FORCE lists
# personas (names or IDs, * for all) that always join through a relay.
# REI_NATION_GERA_RELAY_DIR=/gera-relay
# REI_NATION_GERA_RELAY_HOST_DIR=./relay
# REI_NATION_GERA_RELAY_FORCE=
# Also write logs to this file when running outside Docker.
# REI_NATION_LOG_FILE=server.log

# Optional remote TSFP relay.
# REI_NATION_TSFP_RELAY_IP=
# REI_NATION_TSFP_RELAY_TOKENS=/relay-control/tokens.txt
# REI_NATION_TSFP_RELAY_CONTROL_CERT=/relay-control/control-cert.pem
# REI_NATION_TSFP_RELAY_CONTROL_KEY=/relay-control/control-key.pem
# REI_NATION_TSFP_RELAY_DIR=/absolute/host/path/to/relay-control

# Optional account recovery email. The SMTP server must offer STARTTLS.
# REI_NATION_SMTP_ADDR=smtp.example.com:587
# REI_NATION_SMTP_FROM=help@example.com
# REI_NATION_SMTP_USER=
# REI_NATION_SMTP_PASSWORD=
